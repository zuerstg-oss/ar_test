<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GitHub Test Page</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      max-width: 720px;
      margin: 48px auto;
      padding: 0 16px;
      line-height: 1.6;
      color: #1f2328;
    }
    .card {
      border: 1px solid #d0d7de;
      border-radius: 8px;
      padding: 20px;
      margin-top: 16px;
      background: #f6f8fa;
    }
    button {
      padding: 8px 16px;
      border-radius: 6px;
      border: 1px solid #1f883d;
      background: #1f883d;
      color: #fff;
      font-size: 14px;
      cursor: pointer;
    }
    button:hover {
      background: #1a7f37;
    }
    #result {
      margin-top: 12px;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <h1>GitHub テストページ</h1>
  <p>HTML・CSS・JavaScriptの動作を確認するための最小構成サンプルです。</p>

  <div class="card">
    <button id="testBtn" type="button">動作テストを実行</button>
    <p id="result">未実行</p>
  </div>

  <script>
    const btn = document.getElementById("testBtn");
    const result = document.getElementById("result");
    let count = 0;

    btn.addEventListener("click", () => {
      count += 1;
      const now = new Date().toLocaleTimeString("ja-JP");
      result.textContent = `正常動作を確認（${count}回目 / ${now}）`;
    });
  </script>
</body>
</html>

